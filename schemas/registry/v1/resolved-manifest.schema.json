{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cdin-editor/spec/schemas/registry/v1/resolved-manifest.schema.json",
  "title": "Registry Resolved Manifest",
  "type": "object",
  "$defs": {
    "componentId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 128
    },
    "variantId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 64
    },
    "sourceUnitId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 64
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "versionConstraint": {
      "type": "string",
      "pattern": "^(?:=?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?|(?:>=|<=|=|>|<)(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?: (?:>=|<=|=|>|<)(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?)*)$",
      "minLength": 1,
      "maxLength": 256
    },
    "contractId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
      "minLength": 1,
      "maxLength": 200
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "gitRevision": {
      "type": "string",
      "pattern": "^(?:[a-fA-F0-9]{40}|[a-fA-F0-9]{64})$"
    }
  },
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "registry_version": {
      "$ref": "#/$defs/semver"
    },
    "product": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "$ref": "#/$defs/semver"
        }
      },
      "additionalProperties": true
    },
    "catalogs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "catalog_id": {
            "type": "string"
          },
          "metadata_uri": {
            "type": "string",
            "format": "uri"
          },
          "metadata_sha256": {
            "$ref": "#/$defs/sha256"
          }
        },
        "required": [
          "catalog_id",
          "metadata_uri",
          "metadata_sha256"
        ],
        "additionalProperties": true
      }
    },
    "roots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "component_id": {
            "$ref": "#/$defs/componentId"
          },
          "variant": {
            "$ref": "#/$defs/variantId"
          },
          "version": {
            "$ref": "#/$defs/semver"
          }
        },
        "required": [
          "component_id",
          "variant",
          "version"
        ],
        "additionalProperties": true
      },
      "minItems": 1
    },
    "environment_contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "contract_id": {
            "$ref": "#/$defs/contractId"
          },
          "version": {
            "$ref": "#/$defs/semver"
          }
        },
        "required": [
          "contract_id",
          "version"
        ],
        "additionalProperties": true
      },
      "default": []
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "component_id": {
            "$ref": "#/$defs/componentId"
          },
          "variant": {
            "$ref": "#/$defs/variantId"
          },
          "version": {
            "$ref": "#/$defs/semver"
          },
          "release_metadata_uri": {
            "type": "string",
            "format": "uri"
          },
          "release_metadata_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "source_units": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "source_unit_id": {
                  "$ref": "#/$defs/sourceUnitId"
                },
                "repository_uri": {
                  "type": "string",
                  "format": "uri"
                },
                "revision": {
                  "$ref": "#/$defs/gitRevision"
                },
                "subdirectory": {
                  "type": "string"
                },
                "workspace_path": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "source_unit_id",
                "repository_uri",
                "revision",
                "workspace_path"
              ],
              "additionalProperties": true
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "component_id": {
                  "$ref": "#/$defs/componentId"
                },
                "variant": {
                  "$ref": "#/$defs/variantId"
                },
                "version": {
                  "$ref": "#/$defs/semver"
                }
              },
              "required": [
                "component_id",
                "variant",
                "version"
              ],
              "additionalProperties": true
            }
          },
          "contracts": {
            "type": "object",
            "properties": {
              "provides": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "contract_id": {
                      "$ref": "#/$defs/contractId"
                    },
                    "version": {
                      "$ref": "#/$defs/semver"
                    }
                  },
                  "required": [
                    "contract_id",
                    "version"
                  ],
                  "additionalProperties": true
                }
              },
              "requires": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "contract_id": {
                      "$ref": "#/$defs/contractId"
                    },
                    "version_constraint": {
                      "$ref": "#/$defs/versionConstraint"
                    }
                  },
                  "required": [
                    "contract_id",
                    "version_constraint"
                  ],
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          }
        },
        "required": [
          "component_id",
          "variant",
          "version",
          "release_metadata_uri",
          "release_metadata_sha256",
          "source_units",
          "dependencies"
        ],
        "additionalProperties": true
      }
    },
    "resolution_order": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "component_id": {
            "$ref": "#/$defs/componentId"
          },
          "variant": {
            "$ref": "#/$defs/variantId"
          },
          "version": {
            "$ref": "#/$defs/semver"
          }
        },
        "required": [
          "component_id",
          "variant",
          "version"
        ],
        "additionalProperties": true
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "registry_version",
    "catalogs",
    "roots",
    "components",
    "resolution_order"
  ],
  "additionalProperties": true
}
