{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cdin-editor/spec/schemas/registry/v1/catalog-index.schema.json",
  "title": "Registry Catalog Index",
  "type": "object",
  "$defs": {
    "componentId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 128
    },
    "variantId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 64
    },
    "sourceUnitId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 64
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "versionConstraint": {
      "type": "string",
      "pattern": "^(?:=?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?|(?:>=|<=|=|>|<)(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?: (?:>=|<=|=|>|<)(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?)*)$",
      "minLength": 1,
      "maxLength": 256
    },
    "contractId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
      "minLength": 1,
      "maxLength": 200
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "gitRevision": {
      "type": "string",
      "pattern": "^(?:[a-fA-F0-9]{40}|[a-fA-F0-9]{64})$"
    },
    "releaseSource": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "minLength": 1,
          "maxLength": 128
        },
        "provider": {
          "const": "github-releases-v1"
        },
        "repository_uri": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/?$"
        },
        "component_id": {
          "$ref": "#/$defs/componentId"
        },
        "variant": {
          "$ref": "#/$defs/variantId",
          "default": "default"
        },
        "tag_prefix": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._+-]{0,32}$",
          "maxLength": 32,
          "default": "v"
        }
      },
      "required": [
        "source_id",
        "provider",
        "repository_uri",
        "component_id"
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "catalog_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 128
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "component_id": {
            "$ref": "#/$defs/componentId"
          },
          "variant": {
            "$ref": "#/$defs/variantId",
            "default": "default"
          },
          "version": {
            "$ref": "#/$defs/semver"
          },
          "metadata_uri": {
            "type": "string",
            "format": "uri"
          },
          "metadata_sha256": {
            "$ref": "#/$defs/sha256"
          }
        },
        "required": [
          "component_id",
          "version",
          "metadata_uri",
          "metadata_sha256"
        ],
        "additionalProperties": true
      }
    },
    "extensions": {
      "type": "object"
    },
    "release_sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/releaseSource"
      },
      "description": "One generic GitHub Release discovery source per logical component/variant; versions and metadata assets are discovered from published Releases."
    }
  },
  "required": [
    "schema_version",
    "catalog_id"
  ],
  "additionalProperties": true,
  "oneOf": [
    {
      "required": [
        "entries"
      ],
      "not": {
        "required": [
          "release_sources"
        ]
      }
    },
    {
      "required": [
        "release_sources"
      ],
      "not": {
        "required": [
          "entries"
        ]
      }
    }
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "release_sources"
        ]
      },
      "then": {
        "properties": {
          "schema_version": {
            "pattern": "^1\\.[1-9][0-9]*\\.(?:0|[1-9][0-9]*)$"
          }
        }
      }
    }
  ]
}
