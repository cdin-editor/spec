{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cdin-editor/spec/schemas/registry/v1/component-release.schema.json",
  "title": "Registry Component Release Metadata",
  "type": "object",
  "$defs": {
    "componentId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 128
    },
    "variantId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 64
    },
    "sourceUnitId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 64
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "versionConstraint": {
      "type": "string",
      "pattern": "^(?:=?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?|(?:>=|<=|=|>|<)(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?: (?:>=|<=|=|>|<)(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?)*)$",
      "minLength": 1,
      "maxLength": 256
    },
    "contractId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
      "minLength": 1,
      "maxLength": 200
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "gitRevision": {
      "type": "string",
      "pattern": "^(?:[a-fA-F0-9]{40}|[a-fA-F0-9]{64})$"
    }
  },
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "component_id": {
      "$ref": "#/$defs/componentId"
    },
    "variant": {
      "$ref": "#/$defs/variantId",
      "default": "default"
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "withdrawn"
      ]
    },
    "withdrawal_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "source_units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "source_unit_id": {
            "$ref": "#/$defs/sourceUnitId"
          },
          "repository_uri": {
            "type": "string",
            "format": "uri"
          },
          "revision": {
            "$ref": "#/$defs/gitRevision"
          },
          "subdirectory": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "source_unit_id",
          "repository_uri",
          "revision"
        ],
        "additionalProperties": true
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "component_id": {
            "$ref": "#/$defs/componentId"
          },
          "variant": {
            "$ref": "#/$defs/variantId",
            "default": "default"
          },
          "version_constraint": {
            "$ref": "#/$defs/versionConstraint"
          }
        },
        "required": [
          "component_id",
          "version_constraint"
        ],
        "additionalProperties": true
      },
      "default": []
    },
    "contracts": {
      "type": "object",
      "properties": {
        "provides": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "contract_id": {
                "$ref": "#/$defs/contractId"
              },
              "version": {
                "$ref": "#/$defs/semver"
              }
            },
            "required": [
              "contract_id",
              "version"
            ],
            "additionalProperties": true
          },
          "default": []
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "contract_id": {
                "$ref": "#/$defs/contractId"
              },
              "version_constraint": {
                "$ref": "#/$defs/versionConstraint"
              }
            },
            "required": [
              "contract_id",
              "version_constraint"
            ],
            "additionalProperties": true
          },
          "default": []
        }
      },
      "additionalProperties": true
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "component_id",
    "version",
    "status",
    "source_units"
  ],
  "additionalProperties": true
}
