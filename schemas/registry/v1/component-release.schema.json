{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cdin-editor/spec/schemas/registry/v1/component-release.schema.json",
  "title": "Registry Component Release Metadata",
  "type": "object",
  "$defs": {
    "componentId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 128
    },
    "variantId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 64
    },
    "sourceUnitId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 64
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "versionConstraint": {
      "type": "string",
      "pattern": "^(?:=?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?|(?:>=|<=|=|>|<)(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?: (?:>=|<=|=|>|<)(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?)*)$",
      "minLength": 1,
      "maxLength": 256
    },
    "contractId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
      "minLength": 1,
      "maxLength": 200
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "gitRevision": {
      "type": "string",
      "pattern": "^(?:[a-fA-F0-9]{40}|[a-fA-F0-9]{64})$"
    },
    "target": {
      "type": "object",
      "properties": {
        "os": {
          "type": "string",
          "enum": [
            "linux",
            "darwin",
            "windows",
            "freebsd",
            "openbsd",
            "any"
          ]
        },
        "architecture": {
          "type": "string",
          "enum": [
            "x86_64",
            "arm64",
            "any"
          ]
        },
        "abi": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._+-]{0,63}$"
        }
      },
      "required": [
        "os",
        "architecture",
        "abi"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "os": {
              "const": "any"
            },
            "architecture": {
              "const": "any"
            },
            "abi": {
              "const": "none"
            }
          },
          "required": [
            "os",
            "architecture",
            "abi"
          ]
        },
        {
          "properties": {
            "os": {
              "enum": [
                "linux",
                "darwin",
                "windows",
                "freebsd",
                "openbsd"
              ]
            },
            "architecture": {
              "enum": [
                "x86_64",
                "arm64"
              ]
            },
            "abi": {
              "not": {
                "const": "none"
              },
              "pattern": "^[a-z0-9][a-z0-9._+-]{0,63}$"
            }
          },
          "required": [
            "os",
            "architecture",
            "abi"
          ]
        }
      ]
    },
    "artifact": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "minLength": 1,
          "maxLength": 128
        },
        "kind": {
          "type": "string",
          "enum": [
            "native-development-package",
            "runtime-module-archive",
            "sdk-package"
          ]
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "format": {
          "type": "string",
          "enum": [
            "tar.gz",
            "zip"
          ]
        },
        "file_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,254}$"
        },
        "uri": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "layout": {
          "type": "string",
          "enum": [
            "cmake-prefix-v1",
            "lua-module-tree-v1"
          ]
        },
        "source_unit_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sourceUnitId"
          }
        },
        "build": {
          "type": "object",
          "properties": {
            "recipe": {
              "type": "object",
              "properties": {
                "source_unit_id": {
                  "$ref": "#/$defs/sourceUnitId"
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024,
                  "allOf": [
                    {
                      "not": {
                        "pattern": "^/"
                      }
                    },
                    {
                      "not": {
                        "pattern": "^[A-Za-z]:"
                      }
                    },
                    {
                      "not": {
                        "pattern": "\\\\"
                      }
                    },
                    {
                      "not": {
                        "pattern": "(^|/)\\.\\.?(/|$)"
                      }
                    }
                  ]
                }
              },
              "required": [
                "source_unit_id",
                "path"
              ],
              "additionalProperties": true
            },
            "toolchain": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "required": [
                  "name",
                  "version"
                ],
                "additionalProperties": true
              }
            },
            "runner": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "recipe",
            "toolchain"
          ],
          "additionalProperties": true
        },
        "attestations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "uri": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{64}$"
              },
              "predicate_type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "required": [
              "uri",
              "sha256",
              "predicate_type"
            ],
            "additionalProperties": true
          }
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "target",
        "format",
        "file_name",
        "uri",
        "sha256",
        "size_bytes",
        "layout",
        "source_unit_ids",
        "build"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "runtime-module-archive"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "layout": {
                "const": "lua-module-tree-v1"
              },
              "target": {
                "properties": {
                  "os": {
                    "const": "any"
                  },
                  "architecture": {
                    "const": "any"
                  },
                  "abi": {
                    "const": "none"
                  }
                },
                "required": [
                  "os",
                  "architecture",
                  "abi"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "layout": {
                "const": "cmake-prefix-v1"
              },
              "target": {
                "properties": {
                  "os": {
                    "enum": [
                      "linux",
                      "darwin",
                      "windows",
                      "freebsd",
                      "openbsd"
                    ]
                  },
                  "architecture": {
                    "enum": [
                      "x86_64",
                      "arm64"
                    ]
                  }
                },
                "required": [
                  "os",
                  "architecture"
                ]
              }
            }
          }
        }
      ]
    },
    "publication": {
      "type": "object",
      "properties": {
        "provider": {
          "const": "github-releases-v1"
        },
        "repository_uri": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/?$"
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^/\\\\?#]+$"
        },
        "tag_commit": {
          "$ref": "#/$defs/gitRevision"
        },
        "metadata_asset_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,254}\\.json$"
        }
      },
      "required": [
        "provider",
        "repository_uri",
        "tag",
        "tag_commit",
        "metadata_asset_name"
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "component_id": {
      "$ref": "#/$defs/componentId"
    },
    "variant": {
      "$ref": "#/$defs/variantId",
      "default": "default"
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "withdrawn"
      ]
    },
    "withdrawal_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "source_units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "source_unit_id": {
            "$ref": "#/$defs/sourceUnitId"
          },
          "repository_uri": {
            "type": "string",
            "format": "uri"
          },
          "revision": {
            "$ref": "#/$defs/gitRevision"
          },
          "subdirectory": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "source_unit_id",
          "repository_uri",
          "revision"
        ],
        "additionalProperties": true
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "component_id": {
            "$ref": "#/$defs/componentId"
          },
          "variant": {
            "$ref": "#/$defs/variantId",
            "default": "default"
          },
          "version_constraint": {
            "$ref": "#/$defs/versionConstraint"
          }
        },
        "required": [
          "component_id",
          "version_constraint"
        ],
        "additionalProperties": true
      },
      "default": []
    },
    "contracts": {
      "type": "object",
      "properties": {
        "provides": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "contract_id": {
                "$ref": "#/$defs/contractId"
              },
              "version": {
                "$ref": "#/$defs/semver"
              }
            },
            "required": [
              "contract_id",
              "version"
            ],
            "additionalProperties": true
          },
          "default": []
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "contract_id": {
                "$ref": "#/$defs/contractId"
              },
              "version_constraint": {
                "$ref": "#/$defs/versionConstraint"
              }
            },
            "required": [
              "contract_id",
              "version_constraint"
            ],
            "additionalProperties": true
          },
          "default": []
        }
      },
      "additionalProperties": true
    },
    "extensions": {
      "type": "object"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      },
      "description": "Optional immutable target-specific package artifacts. Source units remain the authoritative source identity."
    },
    "publication": {
      "$ref": "#/$defs/publication"
    }
  },
  "required": [
    "schema_version",
    "component_id",
    "version",
    "status",
    "source_units"
  ],
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "required": [
          "artifacts"
        ]
      },
      "then": {
        "properties": {
          "schema_version": {
            "pattern": "^1\\.[1-9][0-9]*\\.(?:0|[1-9][0-9]*)$"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "publication"
        ]
      },
      "then": {
        "properties": {
          "schema_version": {
            "pattern": "^1\\.(?:[2-9]|[1-9][0-9]+)\\.(?:0|[1-9][0-9]*)$"
          }
        }
      }
    }
  ]
}
