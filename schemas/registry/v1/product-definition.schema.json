{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cdin-editor/spec/schemas/registry/v1/product-definition.schema.json",
  "title": "Registry Product Definition",
  "type": "object",
  "$defs": {
    "componentId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 128
    },
    "variantId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 64
    },
    "sourceUnitId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 64
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "versionConstraint": {
      "type": "string",
      "pattern": "^(?:=?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?|(?:>=|<=|=|>|<)(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?: (?:>=|<=|=|>|<)(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?)*)$",
      "minLength": 1,
      "maxLength": 256
    },
    "contractId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
      "minLength": 1,
      "maxLength": 200
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "gitRevision": {
      "type": "string",
      "pattern": "^(?:[a-fA-F0-9]{40}|[a-fA-F0-9]{64})$"
    },
    "target": {
      "type": "object",
      "properties": {
        "os": {
          "type": "string",
          "enum": [
            "linux",
            "darwin",
            "windows",
            "freebsd",
            "openbsd",
            "any"
          ]
        },
        "architecture": {
          "type": "string",
          "enum": [
            "x86_64",
            "arm64",
            "any"
          ]
        },
        "abi": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._+-]{0,63}$"
        }
      },
      "required": [
        "os",
        "architecture",
        "abi"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "os": {
              "const": "any"
            },
            "architecture": {
              "const": "any"
            },
            "abi": {
              "const": "none"
            }
          },
          "required": [
            "os",
            "architecture",
            "abi"
          ]
        },
        {
          "properties": {
            "os": {
              "enum": [
                "linux",
                "darwin",
                "windows",
                "freebsd",
                "openbsd"
              ]
            },
            "architecture": {
              "enum": [
                "x86_64",
                "arm64"
              ]
            },
            "abi": {
              "not": {
                "const": "none"
              },
              "pattern": "^[a-z0-9][a-z0-9._+-]{0,63}$"
            }
          },
          "required": [
            "os",
            "architecture",
            "abi"
          ]
        }
      ]
    }
  },
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "product": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "$ref": "#/$defs/semver"
        }
      },
      "additionalProperties": true
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "component_id": {
            "$ref": "#/$defs/componentId"
          },
          "variant": {
            "$ref": "#/$defs/variantId",
            "default": "default"
          },
          "version_constraint": {
            "$ref": "#/$defs/versionConstraint"
          }
        },
        "required": [
          "component_id",
          "version_constraint"
        ],
        "additionalProperties": true
      }
    },
    "environment_contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "contract_id": {
            "$ref": "#/$defs/contractId"
          },
          "version": {
            "$ref": "#/$defs/semver"
          }
        },
        "required": [
          "contract_id",
          "version"
        ],
        "additionalProperties": true
      },
      "default": []
    },
    "policy": {
      "type": "object",
      "properties": {
        "allow_prerelease": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": true
    },
    "extensions": {
      "type": "object"
    },
    "resolution": {
      "type": "object",
      "properties": {
        "delivery_mode": {
          "type": "string",
          "enum": [
            "source",
            "artifact",
            "artifact-or-source"
          ],
          "default": "source"
        },
        "target": {
          "$ref": "#/$defs/target"
        }
      },
      "required": [
        "delivery_mode"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "schema_version",
    "components"
  ],
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "required": [
          "resolution"
        ],
        "properties": {
          "resolution": {
            "properties": {
              "delivery_mode": {
                "enum": [
                  "artifact",
                  "artifact-or-source"
                ]
              }
            },
            "required": [
              "delivery_mode"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "resolution": {
            "required": [
              "target"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "resolution"
        ]
      },
      "then": {
        "properties": {
          "schema_version": {
            "pattern": "^1\\.[1-9][0-9]*\\.(?:0|[1-9][0-9]*)$"
          }
        }
      }
    }
  ]
}
