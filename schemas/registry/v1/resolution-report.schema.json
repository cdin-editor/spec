{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cdin-editor/spec/schemas/registry/v1/resolution-report.schema.json",
  "title": "Registry Resolution Report",
  "type": "object",
  "$defs": {
    "componentId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 128
    },
    "variantId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 64
    },
    "sourceUnitId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 64
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "versionConstraint": {
      "type": "string",
      "pattern": "^(?:=?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?|(?:>=|<=|=|>|<)(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?: (?:>=|<=|=|>|<)(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?)*)$",
      "minLength": 1,
      "maxLength": 256
    },
    "contractId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
      "minLength": 1,
      "maxLength": 200
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "gitRevision": {
      "type": "string",
      "pattern": "^(?:[a-fA-F0-9]{40}|[a-fA-F0-9]{64})$"
    },
    "conflictCode": {
      "type": "string",
      "enum": [
        "NO_ROOT_REQUIREMENTS",
        "INVALID_COMPONENT_ID",
        "INVALID_VERSION_CONSTRAINT",
        "INVALID_CATALOG",
        "INVALID_RELEASE_IDENTITY",
        "INVALID_RELEASE_VERSION",
        "INVALID_RELEASE_STATUS",
        "MISSING_SOURCE_UNITS",
        "INVALID_SOURCE_IDENTITY",
        "RESOLUTION_LIMIT",
        "INVALID_DEPENDENCY_ID",
        "INVALID_DEPENDENCY_CONSTRAINT",
        "CONSTRAINT_INTERSECTION_EMPTY",
        "AMBIGUOUS_RELEASE",
        "NO_COMPATIBLE_RELEASE",
        "DEPENDENCY_CONFLICT",
        "DEPENDENCY_CYCLE",
        "INVALID_CONTRACT_ID",
        "INVALID_CONTRACT_VERSION",
        "INVALID_ENVIRONMENT_CONTRACT",
        "INVALID_CONTRACT_CONSTRAINT",
        "CONTRACT_PROVIDER_MISSING",
        "CONTRACT_PROVIDER_AMBIGUOUS",
        "INTERNAL_UNRESOLVED_DEPENDENCY",
        "ARTIFACT_NOT_FOUND",
        "ARTIFACT_AMBIGUOUS"
      ]
    },
    "rejectionReasonCode": {
      "type": "string",
      "enum": [
        "WITHDRAWN",
        "PRERELEASE_DISABLED",
        "CONSTRAINT_MISMATCH",
        "BRANCH_CONFLICT"
      ]
    },
    "resolutionNode": {
      "type": "object",
      "properties": {
        "component_id": {
          "$ref": "#/$defs/componentId"
        },
        "variant": {
          "$ref": "#/$defs/variantId"
        },
        "version": {
          "$ref": "#/$defs/semver"
        }
      },
      "required": [
        "component_id",
        "variant"
      ],
      "additionalProperties": true
    },
    "constraintSource": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "root",
            "dependency"
          ]
        },
        "component_id": {
          "$ref": "#/$defs/componentId"
        },
        "variant": {
          "$ref": "#/$defs/variantId"
        },
        "version": {
          "$ref": "#/$defs/semver"
        }
      },
      "required": [
        "type"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "dependency"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "component_id",
              "variant",
              "version"
            ]
          }
        }
      ],
      "additionalProperties": true
    },
    "appliedConstraint": {
      "type": "object",
      "properties": {
        "component_id": {
          "$ref": "#/$defs/componentId"
        },
        "variant": {
          "$ref": "#/$defs/variantId"
        },
        "version_constraint": {
          "$ref": "#/$defs/versionConstraint"
        },
        "source": {
          "$ref": "#/$defs/constraintSource"
        }
      },
      "required": [
        "component_id",
        "variant",
        "version_constraint",
        "source"
      ],
      "additionalProperties": true
    },
    "contractProviderEvidence": {
      "type": "object",
      "properties": {
        "origin": {
          "type": "string",
          "enum": [
            "component",
            "environment"
          ]
        },
        "component_id": {
          "$ref": "#/$defs/componentId"
        },
        "variant": {
          "$ref": "#/$defs/variantId"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "catalog_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "release_metadata_uri": {
          "type": "string",
          "format": "uri"
        },
        "release_metadata_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "compatible": {
          "type": "boolean"
        },
        "component_version": {
          "$ref": "#/$defs/semver"
        }
      },
      "required": [
        "origin",
        "version",
        "compatible"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "origin": {
                "const": "component"
              }
            },
            "required": [
              "origin"
            ]
          },
          "then": {
            "required": [
              "component_id",
              "variant"
            ]
          }
        }
      ],
      "additionalProperties": true
    },
    "contractEvidence": {
      "type": "object",
      "properties": {
        "contract_id": {
          "$ref": "#/$defs/contractId"
        },
        "requested_constraint": {
          "$ref": "#/$defs/versionConstraint"
        },
        "requiring_component": {
          "type": "object",
          "properties": {
            "component_id": {
              "$ref": "#/$defs/componentId"
            },
            "variant": {
              "$ref": "#/$defs/variantId"
            },
            "version": {
              "$ref": "#/$defs/semver"
            }
          },
          "required": [
            "component_id",
            "variant",
            "version"
          ],
          "additionalProperties": true
        },
        "providers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contractProviderEvidence"
          }
        }
      },
      "required": [
        "contract_id",
        "requested_constraint",
        "requiring_component",
        "providers"
      ],
      "additionalProperties": true
    },
    "releaseIdentity": {
      "type": "object",
      "properties": {
        "component_id": {
          "$ref": "#/$defs/componentId"
        },
        "variant": {
          "$ref": "#/$defs/variantId"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "catalog_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "release_metadata_uri": {
          "type": "string",
          "format": "uri"
        },
        "release_metadata_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "component_id",
        "variant",
        "version"
      ],
      "additionalProperties": true
    }
  },
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "result": {
      "type": "string",
      "enum": [
        "success",
        "failure"
      ]
    },
    "selected": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "component_id": {
            "$ref": "#/$defs/componentId"
          },
          "variant": {
            "$ref": "#/$defs/variantId"
          },
          "version": {
            "$ref": "#/$defs/semver"
          }
        },
        "required": [
          "component_id",
          "variant",
          "version"
        ],
        "additionalProperties": true
      },
      "default": []
    },
    "rejected_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "component_id": {
            "$ref": "#/$defs/componentId"
          },
          "variant": {
            "$ref": "#/$defs/variantId"
          },
          "version": {
            "$ref": "#/$defs/semver"
          },
          "reason_code": {
            "$ref": "#/$defs/rejectionReasonCode"
          },
          "detail": {
            "type": "string",
            "maxLength": 4000
          },
          "catalog_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "release_metadata_uri": {
            "type": "string",
            "format": "uri"
          },
          "release_metadata_sha256": {
            "$ref": "#/$defs/sha256"
          }
        },
        "required": [
          "component_id",
          "variant",
          "version",
          "reason_code"
        ],
        "additionalProperties": true
      },
      "default": []
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "$ref": "#/$defs/conflictCode"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "involved_components": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/componentId"
            }
          },
          "cycle_path": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "component_id": {
                  "$ref": "#/$defs/componentId"
                },
                "variant": {
                  "$ref": "#/$defs/variantId"
                },
                "version": {
                  "$ref": "#/$defs/semver"
                }
              },
              "required": [
                "component_id",
                "variant",
                "version"
              ],
              "additionalProperties": true
            }
          },
          "involved_nodes": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/resolutionNode"
            }
          },
          "contract_evidence": {
            "$ref": "#/$defs/contractEvidence"
          },
          "candidate_evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/releaseIdentity"
            }
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": true
      },
      "default": []
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": true
      },
      "default": []
    },
    "extensions": {
      "type": "object"
    },
    "applied_constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/appliedConstraint"
      },
      "default": []
    }
  },
  "required": [
    "schema_version",
    "result",
    "selected",
    "rejected_candidates",
    "conflicts",
    "warnings"
  ],
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "pattern": "^1\\.[1-9][0-9]*\\.[0-9]+$"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "applied_constraints"
        ]
      }
    }
  ]
}
