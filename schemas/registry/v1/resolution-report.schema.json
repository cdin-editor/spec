{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cdin-editor/spec/schemas/registry/v1/resolution-report.schema.json",
  "title": "Registry Resolution Report",
  "type": "object",
  "$defs": {
    "componentId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 128
    },
    "variantId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 64
    },
    "sourceUnitId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 64
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "versionConstraint": {
      "type": "string",
      "pattern": "^(?:=?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?|(?:>=|<=|=|>|<)(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?: (?:>=|<=|=|>|<)(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?)*)$",
      "minLength": 1,
      "maxLength": 256
    },
    "contractId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
      "minLength": 1,
      "maxLength": 200
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "gitRevision": {
      "type": "string",
      "pattern": "^(?:[a-fA-F0-9]{40}|[a-fA-F0-9]{64})$"
    }
  },
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "result": {
      "type": "string",
      "enum": [
        "success",
        "failure"
      ]
    },
    "selected": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "component_id": {
            "$ref": "#/$defs/componentId"
          },
          "variant": {
            "$ref": "#/$defs/variantId"
          },
          "version": {
            "$ref": "#/$defs/semver"
          }
        },
        "required": [
          "component_id",
          "variant",
          "version"
        ],
        "additionalProperties": true
      },
      "default": []
    },
    "rejected_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "component_id": {
            "$ref": "#/$defs/componentId"
          },
          "variant": {
            "$ref": "#/$defs/variantId"
          },
          "version": {
            "$ref": "#/$defs/semver"
          },
          "reason_code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "detail": {
            "type": "string",
            "maxLength": 4000
          }
        },
        "required": [
          "component_id",
          "variant",
          "version",
          "reason_code"
        ],
        "additionalProperties": true
      },
      "default": []
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "involved_components": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/componentId"
            }
          },
          "cycle_path": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "component_id": {
                  "$ref": "#/$defs/componentId"
                },
                "variant": {
                  "$ref": "#/$defs/variantId"
                },
                "version": {
                  "$ref": "#/$defs/semver"
                }
              },
              "required": [
                "component_id",
                "variant",
                "version"
              ],
              "additionalProperties": true
            }
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": true
      },
      "default": []
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": true
      },
      "default": []
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "result",
    "selected",
    "rejected_candidates",
    "conflicts",
    "warnings"
  ],
  "additionalProperties": true
}
