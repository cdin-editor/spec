{
  "schema": "cdin.frontend-protocol.conformance.v1",
  "family": "proto.ui-presentation",
  "status": "PROPOSED",
  "protocol_version": [
    1,
    0
  ],
  "capability": "ui-presentation/1",
  "limits": {
    "style_table_bytes": 32768,
    "style_roles": 256,
    "panels": 16,
    "widgets_per_panel": 128,
    "widget_depth": 16,
    "total_widgets": 1024,
    "presentation_bytes": 131072
  },
  "cases": [
    {
      "id": "rgba-role-and-emphasis-accepted",
      "capability": "ui-presentation/1",
      "style_table": {
        "revision": 3,
        "styles": {
          "normal": {
            "foreground": {
              "r": 220,
              "g": 224,
              "b": 230,
              "a": 255
            },
            "bold": false
          },
          "keyword": {
            "foreground": {
              "r": 130,
              "g": 160,
              "b": 240,
              "a": 255
            },
            "bold": true,
            "italic": true
          }
        }
      },
      "expect": {
        "accepted": true,
        "roles": 2
      }
    },
    {
      "id": "malformed-color-channel-rejected-atomically",
      "capability": "ui-presentation/1",
      "style_table": {
        "revision": 3,
        "styles": {
          "bad": {
            "foreground": {
              "r": 256,
              "g": 0,
              "b": 0,
              "a": 255
            }
          }
        }
      },
      "expect": {
        "accepted": false,
        "previous_table_preserved": true
      }
    },
    {
      "id": "unknown-role-uses-default-style",
      "capability": "ui-presentation/1",
      "line": {
        "bytes_hex": "616263",
        "spans": [
          {
            "start": 0,
            "end": 3,
            "role": "missing"
          }
        ]
      },
      "expect": {
        "line_visible": true,
        "style": "default"
      }
    },
    {
      "id": "overlapping-spans-rejected",
      "capability": "ui-presentation/1",
      "line": {
        "bytes_hex": "61626364",
        "spans": [
          {
            "start": 0,
            "end": 3,
            "role": "normal"
          },
          {
            "start": 2,
            "end": 4,
            "role": "keyword"
          }
        ]
      },
      "expect": {
        "accepted": false,
        "line_preserved_as_unstyled": true
      }
    },
    {
      "id": "complete-snapshot-removes-omitted-panel",
      "capability": "ui-presentation/1",
      "previous_panels": [
        "tree",
        "search"
      ],
      "next_panels": [
        "tree"
      ],
      "expect": {
        "panels": [
          "tree"
        ]
      }
    },
    {
      "id": "null-prompt-clears-current-prompt",
      "capability": "ui-presentation/1",
      "previous_prompt": "find",
      "next_prompt": null,
      "expect": {
        "prompt": null
      }
    },
    {
      "id": "nested-tree-preserves-order-and-expanded-state",
      "capability": "ui-presentation/1",
      "widget": {
        "id": "root",
        "kind": "tree",
        "nodes": [
          {
            "id": "src",
            "label": "src",
            "expanded": true,
            "children": [
              {
                "id": "main",
                "label": "main.c"
              }
            ]
          }
        ]
      },
      "expect": {
        "accepted": true,
        "node_order": [
          "src",
          "main"
        ]
      }
    },
    {
      "id": "duplicate-widget-id-rejected",
      "capability": "ui-presentation/1",
      "widget": {
        "kind": "list",
        "items": [
          {
            "id": "x",
            "label": "one"
          },
          {
            "id": "x",
            "label": "two"
          }
        ]
      },
      "expect": {
        "accepted": false,
        "panel_previous_state_preserved": true
      }
    },
    {
      "id": "unknown-widget-falls-back-to-static-label",
      "capability": "ui-presentation/1",
      "widget": {
        "id": "w",
        "kind": "future_chart",
        "label": "CPU"
      },
      "expect": {
        "render": "CPU",
        "interactive": false
      }
    },
    {
      "id": "disabled-button-cannot-activate",
      "capability": "ui-presentation/1",
      "driver": true,
      "widget": {
        "id": "save",
        "kind": "button",
        "enabled": false,
        "label": "Save",
        "activate": {
          "command": "document.save"
        }
      },
      "expect": {
        "request_command_sent": false
      }
    },
    {
      "id": "observer-cannot-activate-widget",
      "capability": "ui-presentation/1",
      "driver": false,
      "widget": {
        "id": "save",
        "kind": "button",
        "enabled": true,
        "label": "Save",
        "activate": {
          "command": "document.save"
        }
      },
      "expect": {
        "request_command_sent": false
      }
    },
    {
      "id": "unknown-command-is-runtime-rejected",
      "capability": "ui-presentation/1",
      "driver": true,
      "widget": {
        "id": "x",
        "kind": "button",
        "enabled": true,
        "label": "Run",
        "activate": {
          "command": "missing.command"
        }
      },
      "expect": {
        "runtime_authorization_required": true,
        "frontend_does_not_execute": true
      }
    },
    {
      "id": "missing-capability-is-static-only",
      "capability": null,
      "widget": {
        "id": "open",
        "kind": "button",
        "enabled": true,
        "label": "Open",
        "activate": {
          "command": "file.open"
        }
      },
      "expect": {
        "interactive": false,
        "request_command_sent": false
      }
    },
    {
      "id": "widget-depth-overflow-rejected",
      "capability": "ui-presentation/1",
      "widget_depth": 17,
      "expect": {
        "accepted": false,
        "previous_snapshot_preserved": true
      }
    },
    {
      "id": "stale-snapshot-revision-discarded",
      "capability": "ui-presentation/1",
      "committed_revision": 8,
      "incoming_revision": 8,
      "expect": {
        "accepted": false,
        "previous_snapshot_preserved": true
      }
    },
    {
      "id": "presentation-revision-mismatch-rejected",
      "capability": "ui-presentation/1",
      "model_revision": 9,
      "style_revision": 9,
      "panel_revision": 8,
      "expect": {
        "accepted": false,
        "previous_snapshot_preserved": true
      }
    },
    {
      "id": "unknown-panel-kind-falls-back-to-content",
      "capability": "ui-presentation/1",
      "panel": {
        "kind": "future_panel",
        "title": "Help",
        "widgets": [
          {
            "id": "x",
            "kind": "label",
            "text": "About"
          }
        ]
      },
      "expect": {
        "accepted": true,
        "layout": "content",
        "widget_order": [
          "x"
        ]
      }
    },
    {
      "id": "oversized-action-arguments-rejected",
      "capability": "ui-presentation/1",
      "widget": {
        "id": "run",
        "kind": "button",
        "label": "Run",
        "activate": {
          "command": "run",
          "arguments_bytes": 32769
        }
      },
      "expect": {
        "accepted": false,
        "previous_snapshot_preserved": true
      }
    },
    {
      "id": "input-widget-keeps-unsubmitted-value-local",
      "capability": "ui-presentation/1",
      "driver": true,
      "widget": {
        "id": "query",
        "kind": "input",
        "value": "before",
        "submit": {
          "command": "search.run"
        }
      },
      "local_edit": "after",
      "expect": {
        "document_input_sent": false,
        "request_command_on_change": false,
        "request_command_on_submit": true,
        "submitted_value": "after"
      }
    },
    {
      "id": "input-local-buffer-survives-unrelated-snapshot",
      "capability": "ui-presentation/1",
      "widget": {
        "id": "query",
        "kind": "input",
        "value": "base"
      },
      "local_edit": "draft",
      "next_snapshot": {
        "widget_id": "query",
        "kind": "input",
        "value": "base"
      },
      "expect": {
        "local_buffer": "draft",
        "document_input_sent": false
      }
    },
    {
      "id": "runtime-input-value-change-replaces-local-buffer",
      "capability": "ui-presentation/1",
      "widget": {
        "id": "query",
        "kind": "input",
        "value": "base"
      },
      "local_edit": "draft",
      "next_snapshot": {
        "widget_id": "query",
        "kind": "input",
        "value": "server"
      },
      "expect": {
        "local_buffer": "server",
        "document_input_sent": false
      }
    }
  ]
}
