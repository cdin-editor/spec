{
  "schema_version": "1.0.0",
  "contract": "registry-github-release-discovery-v1",
  "note": "Language-neutral positive and negative conformance cases. These vectors define expected behavior and are not implementation test results.",
  "catalog_cases": [
    {
      "id": "static-catalog-remains-valid",
      "schema_version": "1.0.0",
      "mode": "entries",
      "expected": {
        "result": "accept",
        "mode": "static"
      }
    },
    {
      "id": "dynamic-release-source-valid",
      "schema_version": "1.1.0",
      "source": {
        "source_id": "backend-default",
        "provider": "github-releases-v1",
        "repository_uri": "https://github.com/example/backend",
        "component_id": "backend",
        "variant": "default",
        "tag_prefix": "v"
      },
      "expected": {
        "result": "accept",
        "mode": "github-releases"
      }
    },
    {
      "id": "static-and-dynamic-catalog-must-not-mix",
      "schema_version": "1.1.0",
      "has_entries": true,
      "has_release_sources": true,
      "expected": {
        "result": "reject-schema"
      }
    },
    {
      "id": "unsupported-release-provider",
      "source": {
        "provider": "github-latest"
      },
      "expected": {
        "result": "reject-schema"
      }
    },
    {
      "id": "non-github-repository-uri",
      "source": {
        "provider": "github-releases-v1",
        "repository_uri": "https://example.invalid/project"
      },
      "expected": {
        "result": "reject-schema"
      }
    },
    {
      "id": "duplicate-release-source-id",
      "sources": [
        {
          "source_id": "same",
          "component_id": "backend"
        },
        {
          "source_id": "same",
          "component_id": "runtime"
        }
      ],
      "expected": {
        "result": "reject-semantic",
        "code": "RELEASE_SOURCE_ID_DUPLICATE"
      }
    },
    {
      "id": "duplicate-component-variant-source",
      "sources": [
        {
          "source_id": "backend-a",
          "component_id": "backend",
          "variant": "default"
        },
        {
          "source_id": "backend-b",
          "component_id": "backend",
          "variant": "default"
        }
      ],
      "expected": {
        "result": "reject-semantic",
        "code": "RELEASE_SOURCE_COMPONENT_VARIANT_DUPLICATE"
      }
    }
  ],
  "asset_name_cases": [
    {
      "id": "default-variant-name",
      "component_id": "backend",
      "variant": "default",
      "version": "1.2.1",
      "expected": "backend-1.2.1.json"
    },
    {
      "id": "tui-variant-name",
      "component_id": "frontend",
      "variant": "tui",
      "version": "1.1.0",
      "expected": "frontend-tui-1.1.0.json"
    },
    {
      "id": "gui-sdl-variant-name",
      "component_id": "frontend",
      "variant": "gui-sdl",
      "version": "1.1.0",
      "expected": "frontend-gui-sdl-1.1.0.json"
    }
  ],
  "discovery_cases": [
    {
      "id": "highest-semver-not-most-recent-publication",
      "allow_prerelease": false,
      "releases": [
        {
          "tag": "v1.2.0",
          "version": "1.2.0",
          "published_at": "2026-11-10T10:00:00Z"
        },
        {
          "tag": "v1.3.0",
          "version": "1.3.0",
          "published_at": "2026-11-09T10:00:00Z"
        }
      ],
      "expected": {
        "result": "select",
        "version": "1.3.0"
      }
    },
    {
      "id": "prerelease-excluded-by-default",
      "allow_prerelease": false,
      "releases": [
        {
          "tag": "v2.0.0-rc.1",
          "version": "2.0.0-rc.1",
          "prerelease": true
        },
        {
          "tag": "v1.9.0",
          "version": "1.9.0",
          "prerelease": false
        }
      ],
      "expected": {
        "result": "select",
        "version": "1.9.0"
      }
    },
    {
      "id": "prerelease-included-only-when-allowed",
      "allow_prerelease": true,
      "releases": [
        {
          "tag": "v2.0.0-rc.1",
          "version": "2.0.0-rc.1",
          "prerelease": true
        },
        {
          "tag": "v1.9.0",
          "version": "1.9.0",
          "prerelease": false
        }
      ],
      "expected": {
        "result": "select",
        "version": "2.0.0-rc.1"
      }
    },
    {
      "id": "draft-is-ignored",
      "releases": [
        {
          "tag": "v9.0.0",
          "draft": true,
          "version": "9.0.0"
        },
        {
          "tag": "v1.0.0",
          "draft": false,
          "version": "1.0.0"
        }
      ],
      "expected": {
        "result": "select",
        "version": "1.0.0"
      }
    },
    {
      "id": "invalid-tag-semver",
      "release": {
        "tag": "vlatest"
      },
      "expected": {
        "result": "reject-release",
        "code": "RELEASE_TAG_INVALID"
      }
    },
    {
      "id": "tag-does-not-match-prefix-plus-version",
      "source": {
        "tag_prefix": "v"
      },
      "release": {
        "tag": "release-1.2.1",
        "metadata_version": "1.2.1"
      },
      "expected": {
        "result": "reject-release",
        "code": "RELEASE_TAG_VERSION_MISMATCH"
      }
    },
    {
      "id": "metadata-asset-missing",
      "release": {
        "tag": "v1.2.1",
        "assets": []
      },
      "expected": {
        "result": "reject-release",
        "code": "RELEASE_METADATA_ASSET_MISSING"
      }
    },
    {
      "id": "metadata-asset-ambiguous",
      "release": {
        "tag": "v1.2.1",
        "assets": [
          {
            "name": "backend-1.2.1.json"
          },
          {
            "name": "backend-1.2.1.json"
          }
        ]
      },
      "expected": {
        "result": "reject-release",
        "code": "RELEASE_METADATA_ASSET_AMBIGUOUS"
      }
    },
    {
      "id": "metadata-asset-sha256-required",
      "release": {
        "assets": [
          {
            "name": "backend-1.2.1.json",
            "size": 300,
            "digest": null
          }
        ]
      },
      "expected": {
        "result": "reject-release",
        "code": "RELEASE_METADATA_DIGEST_UNAVAILABLE"
      }
    },
    {
      "id": "metadata-asset-size-and-digest-verified",
      "release": {
        "assets": [
          {
            "name": "backend-1.2.1.json",
            "size": 300,
            "digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
          }
        ],
        "download_size": 299,
        "download_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "expected": {
        "result": "reject-integrity",
        "code": "RELEASE_METADATA_SIZE_MISMATCH"
      }
    },
    {
      "id": "metadata-asset-digest-mismatch",
      "release": {
        "assets": [
          {
            "name": "backend-1.2.1.json",
            "size": 300,
            "digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
          }
        ],
        "download_size": 300,
        "download_sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
      },
      "expected": {
        "result": "reject-integrity",
        "code": "RELEASE_METADATA_DIGEST_MISMATCH"
      }
    },
    {
      "id": "release-prerelease-flag-matches-semver",
      "release": {
        "tag": "v1.2.1-rc.1",
        "version": "1.2.1-rc.1",
        "prerelease": false
      },
      "expected": {
        "result": "reject-release",
        "code": "RELEASE_PRERELEASE_FLAG_MISMATCH"
      }
    },
    {
      "id": "annotated-tag-is-peeled-to-commit",
      "tag_objects": [
        "tag-a",
        "tag-b"
      ],
      "resolved_commit": "1111111111111111111111111111111111111111",
      "metadata_tag_commit": "1111111111111111111111111111111111111111",
      "expected": {
        "result": "accept"
      }
    },
    {
      "id": "tag-ref-was-moved",
      "tag_commit": "2222222222222222222222222222222222222222",
      "metadata_tag_commit": "1111111111111111111111111111111111111111",
      "source_revision": "1111111111111111111111111111111111111111",
      "expected": {
        "result": "reject-release",
        "code": "RELEASE_TAG_MOVED"
      }
    },
    {
      "id": "publisher-source-revision-mismatch",
      "tag_commit": "1111111111111111111111111111111111111111",
      "metadata_tag_commit": "1111111111111111111111111111111111111111",
      "source_revision": "2222222222222222222222222222222222222222",
      "expected": {
        "result": "reject-release",
        "code": "RELEASE_SOURCE_REVISION_MISMATCH"
      }
    },
    {
      "id": "publisher-repository-mismatch",
      "release_repository": "https://github.com/example/other",
      "catalog_repository": "https://github.com/example/backend",
      "expected": {
        "result": "reject-release",
        "code": "RELEASE_REPOSITORY_MISMATCH"
      }
    },
    {
      "id": "two-distinct-identities-same-semver-are-ambiguous",
      "releases": [
        {
          "tag": "v1.2.1",
          "version": "1.2.1",
          "release_id": 10,
          "digest": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        },
        {
          "tag": "v1.2.1-copy",
          "version": "1.2.1",
          "release_id": 11,
          "digest": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
        }
      ],
      "expected": {
        "result": "fail-resolution",
        "code": "RELEASE_VERSION_AMBIGUOUS"
      }
    },
    {
      "id": "pagination-budget-never-selects-partial-candidate-set",
      "pages_examined": 10,
      "max_pages": 10,
      "has_next_page": true,
      "expected": {
        "result": "fail-discovery",
        "code": "RELEASE_DISCOVERY_LIMIT"
      }
    },
    {
      "id": "rate-limit-retry-budget-is-bounded",
      "http_status": 403,
      "rate_limited": true,
      "retry_budget": 3,
      "attempts": 3,
      "expected": {
        "result": "fail-discovery",
        "code": "RELEASE_API_RATE_LIMITED"
      }
    },
    {
      "id": "offline-requires-verified-discovery-cache",
      "offline": true,
      "verified_cache": false,
      "expected": {
        "result": "fail-discovery",
        "code": "RELEASE_DISCOVERY_OFFLINE_MISS"
      }
    },
    {
      "id": "manifest-replay-does-not-reselect-newer-release",
      "manifest": {
        "release_id": 77,
        "tag": "v1.2.1",
        "metadata_uri": "https://github.com/example/backend/releases/download/v1.2.1/backend-1.2.1.json",
        "metadata_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "newer_release": {
        "release_id": 78,
        "tag": "v1.3.0"
      },
      "expected": {
        "result": "fetch-exact-manifest-asset",
        "release_id": 77
      }
    }
  ]
}
